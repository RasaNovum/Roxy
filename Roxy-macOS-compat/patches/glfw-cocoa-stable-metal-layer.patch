+#if defined(_GLFW_COCOA)
+    // This fork routes Cocoa's native-context requests through EGL for Zink.
+    // Normalize the source before validation and window creation so the
+    // context reports its actual backend and skips NSGL-only callbacks.
+    if (ctxconfig.source == GLFW_NATIVE_CONTEXT_API)
+        ctxconfig.source = GLFW_EGL_CONTEXT_API;
+#endif
+
