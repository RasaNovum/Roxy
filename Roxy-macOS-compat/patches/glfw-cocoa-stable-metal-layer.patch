@@ -247,6 +247,12 @@ - (void)windowDidResize:(NSNotification *)notification
     const NSRect contentRect = [window->ns.view frame];
     const NSRect fbRect = [window->ns.view convertRectToBacking:contentRect];
 
+    if (window->ns.layer)
+    {
+        [window->ns.layer setFrame:[window->ns.view bounds]];
