     {
@@ -515,7 +521,10 @@ - (void)viewDidChangeBackingProperties
     if (xscale != window->ns.xscale || yscale != window->ns.yscale)
     {
         if (window->ns.scaleFramebuffer && window->ns.layer)
+        {
             [window->ns.layer setContentsScale:[window->ns.object backingScaleFactor]];
+            [window->ns.layer setDrawableSize:fbRect.size];
+        }
 
         window->ns.xscale = xscale;
         window->ns.yscale = yscale;
@@ -938,10 +947,32 @@ GLFWbool _glfwCreateWindowCocoa(_GLFWwindow* window,
         }
         else if (ctxconfig->source == GLFW_EGL_CONTEXT_API || ctxconfig->source == GLFW_NATIVE_CONTEXT_API) /* PATCHED: Route NATIVE to EGL */
         {
-            // EGL implementation on macOS use CALayer* EGLNativeWindowType so we
-            // need to get the layer for EGL window surface creation.
+            // EGL's macOS native window handle is a CALayer. Give the view a
+            // stable CAMetalLayer up front: Mesa's surfaceless Zink path needs
+            // this layer for Metal presentation and may replace AppKit's
+            // default NSViewBackingLayer while creating the EGL surface.
+            // Keeping the same layer in GLFW avoids a stale pointer during
+            // later display/backing-scale notifications.
             [window->ns.view setWantsLayer:YES];
-            window->ns.layer = [window->ns.view layer];
+            CAMetalLayer* layer = [CAMetalLayer layer];
+            if (!layer)
+            {
+                _glfwInputError(GLFW_PLATFORM_ERROR,
+                                "Cocoa: Failed to create layer for EGL window");
+                return GLFW_FALSE;
+            }
+
+            const NSRect bounds = [window->ns.view bounds];
+            [layer setFrame:bounds];
+            [layer setAutoresizingMask:kCALayerWidthSizable | kCALayerHeightSizable];
+            [layer setOpaque:YES];
+            const CGFloat scale = [window->ns.object backingScaleFactor];
+            if (window->ns.scaleFramebuffer)
+                [layer setContentsScale:scale];
+            [layer setDrawableSize:CGSizeMake(bounds.size.width * scale,
+                                              bounds.size.height * scale)];
+            [window->ns.view setLayer:layer];
+            window->ns.layer = layer;
 
             if (!_glfwInitEGL())
                 return GLFW_FALSE;
@@ -2060,4 +2091,3 @@ GLFWAPI id glfwGetCocoaView(GLFWwindow* handle)
 }
 
