diff --git a/src/window.c b/src/window.c
index f131c20..21c5937 100644
--- a/src/window.c
+++ b/src/window.c
@@ -206,6 +206,14 @@ GLFWAPI GLFWwindow* glfwCreateWindow(int width, int height,
